# PairUp Django Environment Configuration
SECRET_KEY=django-insecure-pairup-dev-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=*

# JWT Configuration
JWT_SECRET=change-this-to-a-long-random-secret
JWT_TTL_HOURS=24

# CORS: Comma-separated list of origins or *
CORS_ALLOWED_ORIGINS=*

# Database: sqlite (default for local) or mysql
DB_CONNECTION=sqlite
DB_NAME=db.sqlite3
DB_USER=root
DB_PASS=
DB_HOST=127.0.0.1
DB_PORT=3306
